# Author Agent Network — Environment Variables
# Copy this file to .env and fill in your credentials

# ── Required ──────────────────────────────────────────────────────────────────
ANTHROPIC_API_KEY=sk-ant-...

# ── Author Info ───────────────────────────────────────────────────────────────
AUTHOR_PEN_NAME=Jane Doe
KDP_EMAIL=you@example.com

# ── Instagram / Meta Graph API ────────────────────────────────────────────────
# Create a Meta Developer App → add Instagram Graph API product
# Generate a long-lived access token (60-day expiry; set up token refresh)
INSTAGRAM_ACCESS_TOKEN=
INSTAGRAM_ACCOUNT_ID=          # Numeric Instagram Business Account ID

# ── WordPress (Author Website) ────────────────────────────────────────────────
# In WP Admin: Users → Profile → Application Passwords → Add New
WORDPRESS_URL=https://yourauthorsite.com
WORDPRESS_USER=your_wp_username
WORDPRESS_APP_PASSWORD=xxxx xxxx xxxx xxxx xxxx xxxx

# ── Local Data Storage ────────────────────────────────────────────────────────
# All research, outlines, manuscripts, and cover briefs are saved here
AUTHOR_DATA_DIR=./author_data
